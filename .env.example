PROJECT_NAME=parallel-truth-fingerprint-prototype
PYTHONPATH=src

# --- MQTT and CometBFT (live runtime) ---
MQTT_TRANSPORT=real
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC=edges/observations
COMETBFT_RPC_URL=http://127.0.0.1:26657

# --- Local demo cadence ---
# Default reduced from 60s to 10s on 2026-05-21 per advisor feedback so
# demo runs accumulate eligible artifacts fast enough for the deferred
# fingerprint stage to be observable in a single session.
DEMO_STEPS=3
DEMO_CYCLE_INTERVAL_SECONDS=10
DEMO_MAX_CYCLES=0
DEMO_TRAIN_AFTER_ELIGIBLE_CYCLES=10
DEMO_FINGERPRINT_SEQUENCE_LENGTH=2
DEMO_POWER=65.0

# --- Dashboard ---
DEMO_DASHBOARD_HOST=127.0.0.1
DEMO_DASHBOARD_PORT=8088

# --- Scenario control ---
DEMO_SCENARIO=
DEMO_SCENARIO_START_CYCLE=1
DEMO_FAULT_MODE=none
DEMO_FAULTY_EDGES=
DEMO_SCADA_MODE=match
DEMO_SCADA_START_CYCLE=0
DEMO_SCADA_OFFSET_VALUE=6.0

# --- MinIO (valid artifacts + training history) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=valid-consensus-artifacts
MINIO_SECURE=false

# --- Offline training track (Epic 7) ---
# Set these to point the benchmark adapters at the real datasets once
# you've obtained ADFA-LD and LID-DS 2021 out-of-band. The CI test suite
# uses embedded fixtures under tests/.../fixtures/ and does NOT require
# these env vars.
# ADFA_LD_PATH=
# LID_DS_2021_PATH=
KERAS_BACKEND=torch

# --- Legacy (deprecated; kept for backward compatibility only) ---
LSTM_SERVICE_HOST=localhost
LSTM_SERVICE_PORT=8001
